#. Key:	T_LEVEL_10_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_10_DESCRIPTION"
msgid "T_LEVEL_10_DESCRIPTION"
msgstr "Final day. Its all or nothing. Cleaning is your job. It is Dorothy's Job."

#. Key:	T_LEVEL_1_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_1_DESCRIPTION"
msgid "T_LEVEL_1_DESCRIPTION"
msgstr "Learn the timers and how to gain time by cleaning a room! The special attack will help you win, use it!"

#. Key:	T_LEVEL_2_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_2_DESCRIPTION"
msgid "T_LEVEL_2_DESCRIPTION"
msgstr "A new enemy appeared! Use your new weapon to attack it... and to clean it! Dust is your new enemy!"

#. Key:	T_LEVEL_3_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_3_DESCRIPTION"
msgid "T_LEVEL_3_DESCRIPTION"
msgstr "More enemies... Grimelings will buff other enemies, but now you have consumables! Use them!"

#. Key:	T_LEVEL_4_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_4_DESCRIPTION"
msgid "T_LEVEL_4_DESCRIPTION"
msgstr "Mopressor is a new way to fight. Perfect for this new variation of Oozers!"

#. Key:	T_LEVEL_5_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_5_DESCRIPTION"
msgid "T_LEVEL_5_DESCRIPTION"
msgstr "Short shift! Use everything you know as efficiently as ever."

#. Key:	T_LEVEL_6_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_6_DESCRIPTION"
msgid "T_LEVEL_6_DESCRIPTION"
msgstr "Dirtminator will come in handy for this amount of Dust... and Ash Bunnies! They may be hiding in their dust..."

#. Key:	T_LEVEL_7_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_7_DESCRIPTION"
msgid "T_LEVEL_7_DESCRIPTION"
msgstr "Enemies seem to have increased their effort to dirty. New day, same job!"

#. Key:	T_LEVEL_8_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_8_DESCRIPTION"
msgid "T_LEVEL_8_DESCRIPTION"
msgstr "Another short shift! Remember, efficiency is key. Use your loudout to its maximum potential!"

#. Key:	T_LEVEL_9_DESCRIPTION
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_LEVEL_9_DESCRIPTION"
msgid "T_LEVEL_9_DESCRIPTION"
msgstr "Kaios seems to be up to no good. But your job is still the same! Crush these monsters quickly!"

