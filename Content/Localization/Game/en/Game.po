#. SourceLocation:	/Game/Data/StringTables/ST_DIALOGS.ST_DIALOGS
#: /Game/Data/StringTables/ST_DIALOGS.ST_DIALOGS
msgctxt "ST_DIALOGS,TUT_EXPO_WORKSH_11"
msgid "TUT_EXPO_WORKSH_11"
msgstr "While on your shift, you can use the gadget in each slot by <b>pressing the gadget buttons</>. You can see them at the <b>Bottom Right</> of your screen."

