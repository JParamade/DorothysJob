#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_CHEST_DM_ATTACK"
msgid "T_CHEST_DM_ATTACK"
msgstr "Dirtminator will charge up and shoot a compressed air cannon ball, which explodes if charged enough. Hasta la vista!"

#. Key:	T_CHEST_DM_CLEAN
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_CHEST_DM_CLEAN"
msgid "T_CHEST_DM_CLEAN"
msgstr "Dirtminator will create a tornado that gulps dust in its growing path... Believe it, they won't be back."

#. Key:	T_CHEST_DM_SPECIAL
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_CHEST_DM_SPECIAL"
msgid "T_CHEST_DM_SPECIAL"
msgstr "Dirtminator enters overcharge, creating an air stream that cleans and kills everything. It's judgement time!"

#. Key:	T_CHEST_DU_ATTACK
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_CHEST_DU_ATTACK"
msgid "T_CHEST_DU_ATTACK"
msgstr "Dusty tightens its feathers, attacking twice, and ending the combo with the fearsome \"Serious Latex Punch\"."

#. Key:	T_CHEST_DU_CLEAN
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_CHEST_DU_CLEAN"
msgid "T_CHEST_DU_CLEAN"
msgstr "Dusty relaxes its feathers to clean. Aim at the Dust mounds weak spot for critical damage!"

#. Key:	T_CHEST_DU_SPECIAL
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_CHEST_DU_SPECIAL"
msgid "T_CHEST_DU_SPECIAL"
msgstr "Join forces with Dusty to spin at incredible speeds, creating a force that ends every monster and dust in its path."

#. Key:	T_CHEST_MP_ATTACK
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_CHEST_MP_ATTACK"
msgid "T_CHEST_MP_ATTACK"
msgstr "Moppressor sweeps in three-hit combos. The watery tip will deal extra damage to those pesky foes!"

#. Key:	T_CHEST_MP_CLEAN
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_CHEST_MP_CLEAN"
msgid "T_CHEST_MP_CLEAN"
msgstr "Moppressor is a mop. C'mon, what did you expect? Dash through enemies to mark them for huge damage!"

#. Key:	T_CHEST_MP_SPECIAL
#. SourceLocation:	/Game/Data/StringTables/ST_UI.ST_UI
#: /Game/Data/StringTables/ST_UI.ST_UI
msgctxt "ST_UI,T_CHEST_MP_SPECIAL"
msgid "T_CHEST_MP_SPECIAL"
msgstr "Charge increasingly more kinetic energy into Moppressor. When released, it unleashes the Ultimate Slam."

#. Key:	T_CHEST_WF_ATTACK
